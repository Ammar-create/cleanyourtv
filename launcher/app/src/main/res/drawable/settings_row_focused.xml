<?xml version="1.0" encoding="utf-8"?>
<!-- The focus pill inside a card. Inset on all four sides so the card's rim, its top specular and
     the hairline dividers stay visible around it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="5dp"
        android:top="3dp"
        android:right="5dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#EBFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
