<?xml version="1.0" encoding="utf-8"?>
<!-- The focus pill inside a card. Inset far enough on all four sides that its corners sit well
     inside the card's 20dp radius (8dp across, 6dp down, 12dp radius), so no part of the pill can
     be sliced off by the card's rounded outline. The card's rim and specular band stay visible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="8dp"
        android:top="6dp"
        android:right="8dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#EBFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
