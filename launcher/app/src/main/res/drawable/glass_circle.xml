<?xml version="1.0" encoding="utf-8"?>
<!-- Circular glass button. At rest it is a quiet smoked disc; focused it lifts to solid white so
     the dark icon inside reads from the sofa. Same lift the dock uses for its selected tab. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#FAFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#3DFFFFFF"
                android:endColor="#12FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#3DFFFFFF" />
        </shape>
    </item>
</selector>
